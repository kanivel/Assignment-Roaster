# .env.example - copy to .env and fill in real values. Never commit .env.

# ---------- Database ----------
# Used when running the backend locally (outside Docker).
# docker-compose overrides this to point at the "postgres" service.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/assignment_roaster

# Postgres container credentials (docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=assignment_roaster

# ---------- Auth ----------
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
FRONTEND_URL=http://localhost:5173
# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------- Google OAuth ----------
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# ---------- AI (OpenAI) ----------
OPENAI_API_KEY=sk-...
# gpt-4.1-mini is the default (fast, good Tanglish). Use gpt-4.1 for higher quality.
# The gpt-5 family spends part of max_output_tokens on reasoning, so raise
# MAX_OUTPUT_TOKENS in backend/app/services/roaster.py before switching to it.
OPENAI_MODEL=gpt-4.1-mini

# ---------- GitHub ----------
# Effectively REQUIRED in production. Unauthenticated GitHub access is limited to
# 60 requests/hour per server IP and one review costs ~43 requests (repo + commit +
# tree + up to 40 blobs), so without a token only ~1 review/hour succeeds.
# A fine-grained or classic token with public repo read access raises the limit
# to 5000 requests/hour.
GITHUB_TOKEN=

# ---------- Limits ----------
MAX_REPO_FILES=40
MAX_FILE_BYTES=20480
SUBMISSIONS_PER_HOUR=5

# ---------- Frontend ----------
# Vite dev server: point directly at the backend.
# Docker production build: set to an empty string so nginx proxies /api/ to the backend.
VITE_API_URL=http://localhost:8000

# HTTPS (docker-compose.https.yml): public hostname with an A record to this server
SITE_DOMAIN=
